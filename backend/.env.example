# Copy this file to .env and fill in your values
# Get a free Groq API key at: https://console.groq.com

GROQ_API_KEY=your_groq_api_key_here

# Optional: override the default model (llama3-70b-8192)
# Other options: llama3-8b-8192, mixtral-8x7b-32768, gemma2-9b-it
# GROQ_MODEL=llama3-70b-8192

# Qualcomm Cloud AI (for final submission — leave blank for local testing)
# QUALCOMM_API_KEY=your_qualcomm_api_key_here
# QUALCOMM_BASE_URL=https://api.qualcomm.com/v1
